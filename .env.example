# ===============================================================
# ORCA — Environment Variables Configuration
# ===============================================================
# Copy this file to:
#   - D:\ORCA\backend\.env (for backend secrets)
#   - D:\ORCA\uiux\.env    (for frontend client variables)
# NEVER commit actual .env files containing real secret values.
# ===============================================================

# ---------------------------------------------------------------
# FRONTEND PUBLIC (Vite client-side — exposed to browser)
# ---------------------------------------------------------------
# Optional Google Maps JavaScript API key for Satellite & Marine Navigation
VITE_GOOGLE_MAPS_API_KEY=
# Optional API base URL override (leave blank for same-origin proxy in development & production)
VITE_ORCA_API_URL=

# ---------------------------------------------------------------
# BACKEND PRIVATE (FastAPI / LangGraph runtime)
# ---------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
APP_URL=http://localhost:3000

# ---------------------------------------------------------------
# LLM (Google Gemini & Reasoning)
# ---------------------------------------------------------------
# Primary Gemini API key for Gemini 3.8 Flash supervisor, tool-calling & reasoning
GEMINI_API_KEY=
# Generic LLM fallback key and model identifier
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------
# DATABASE (PostgreSQL 17 + PostGIS 3.5 + pgvector)
# ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://orca:orca@localhost:5432/orca

# ---------------------------------------------------------------
# REDIS (Event streaming, caching & state coordination)
# ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------
# MINIO (S3-compatible Object Storage for rasters & reports)
# ---------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=orca

# ---------------------------------------------------------------
# MARINE DATA PROVIDERS
# ---------------------------------------------------------------
# Copernicus Marine Service credentials
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# NASA Earthdata (MODIS / VIIRS SST & Ocean Color)
# Register at: https://urs.earthdata.nasa.gov
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_TOKEN=

# INCOIS (Indian National Centre for Ocean Information Services)
INCOIS_BASE_URL=https://incois.gov.in

# ---------------------------------------------------------------
# RESEARCH & ADVANCED AGENTS
# ---------------------------------------------------------------
DEEP_RESEARCH_ENABLED=true

# ---------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ---------------------------------------------------------------
SECRET_KEY=generate_a_random_secure_hex_key_here

# ---------------------------------------------------------------
# OTHER EXTERNAL SERVICES (Multilingual & Speech)
# ---------------------------------------------------------------
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
