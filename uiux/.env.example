# ===============================================================
# ORCA UI/UX — Frontend Client Environment Variables
# ===============================================================
# ONLY variables prefixed with VITE_ are exposed to the client bundle.
# All backend secrets (LLM keys, DB URLs, MinIO, etc.) belong in backend/.env.
# ===============================================================

# Optional Google Maps JavaScript API key for Satellite & Marine Navigation
VITE_GOOGLE_MAPS_API_KEY=

# Optional API base URL override (leave blank to use same-origin proxy in development & production)
VITE_ORCA_API_URL=
